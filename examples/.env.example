# Copy to .env next to docker-compose.yml. Quote values with spaces.

# Required
POSTGRES_PASSWORD=change-me-to-something-long
ADMIN_TOKEN=change-me-openssl-rand-hex-32

# Apps registered at boot (optional; `cli.mjs apps:add` works too)
APPS=myapp=My App

# Event catalog (optional): a JSON file next to this one
# CATALOG_FILE=./catalog.example.json

# Behind a proxy that sets these headers (leave unset otherwise). Behind a
# proxy, set CLIENT_IP_HEADER: without it every caller has the proxy's address
# and shares its rate limits and the daily count of tickets with an email.
# CLIENT_IP_HEADER=x-forwarded-for
# COUNTRY_HEADER=cf-ipcountry

# Raw events are deleted after RETENTION_DAYS (default 180), and an install
# row once the install has sent nothing for INSTALL_RETENTION_DAYS (default:
# RETENTION_DAYS; 0 keeps every install; shorter than RETENTION_DAYS, the row
# goes before its events, and the server warns)
# RETENTION_DAYS=180
# INSTALL_RETENTION_DAYS=

# Ticket email through Resend (optional)
# RESEND_API_KEY=re_...
# MAIL_FROM="Support <support@example.com>"
# ALERT_EMAIL=you@example.com
# REPLY_HINT=https://hush.example.com/dashboard/

# RevenueCat v2 secret key, read-only scopes (optional)
# RC_API_KEY=sk_...

# Host port for the dashboard and API (127.0.0.1 only)
# HUSH_PORT=3000

# A trusted proxy that signs the dashboard in (optional; both or neither,
# the secret 16+ characters)
# ADMIN_PROXY_HEADER=
# ADMIN_PROXY_SECRET=

# 1 logs mail instead of sending it (optional)
# MAIL_DRY_RUN=

# More RevenueCat (optional; defaults in docker-compose.yml)
# RC_PROJECTS=
# RC_CURRENCY=
# RC_STALE_MINUTES=
# RC_FLOOR_SECONDS=
# RC_RATE_PER_MINUTE=

# App Store Connect API key, for App Store campaign reports (optional).
# ASC_PRIVATE_KEY is the .p8 inline (\n allowed); ASC_PRIVATE_KEY_FILE is a
# path inside the container, so mount the file too.
# ASC_KEY_ID=
# ASC_ISSUER_ID=
# ASC_PRIVATE_KEY=
# ASC_PRIVATE_KEY_FILE=
# ASC_API_BASE=

# 1: a public read-only demo with invented data. Wipes its database daily:
# never on a database with real data.
# DEMO=
