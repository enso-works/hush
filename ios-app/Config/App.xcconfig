// The app's own hush: where it sends its anonymous usage and its feedback.
// The address is public; the key comes from Local.xcconfig (not committed:
// the dev key, for runs from Xcode) or from scripts/testflight.sh (the prod
// key). Without one, the app sends nothing.
// "//" starts a comment in an xcconfig, hence $() in the address.
HUSH_URL = https:/$()/telemetry.bavrk.com
HUSH_KEY =

// bavrk's push relay: how a server without an APNs key of its own notifies
// this app (the server's src/relay.mjs). A build under another bundle id
// sends to Apple itself with its own key, and does not need it.
HUSH_PUSH_RELAY = https:/$()/hush.bavrk.com/push

#include? "Local.xcconfig"
